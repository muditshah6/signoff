# Copy to .env.local for local work, or set these in Vercel > Project > Settings > Environment Variables.

# Required in production. Neon: use the *pooled* connection string. Locally, leave unset to use the embedded DB.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Required in production (min 32 chars). Signs sessions, share links and OTP sessions.
#   openssl rand -base64 48
SIGNOFF_SECRET=

# Public demo with synthetic data: open sign-in as any seeded person, OTP shown on screen when no mail provider.
# Leave unset for anything with real client data (there is then NO sign-in until magic link / invites are built).
DEMO_MODE=1

# Optional: real OTP emails to client approvers (Resend). Without these the share flow needs DEMO_MODE.
RESEND_API_KEY=
MAIL_FROM="Signoff <noreply@yourdomain.com>"

# Optional: pin the public origin used in links. Default: the host each request arrives on.
NEXT_PUBLIC_APP_URL=
